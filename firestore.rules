rules_version = '2';

// LOHZ Firestore Security Rules
//
// Goal: enforce user isolation at the database layer. Every rule is
// keyed to the authenticated UID (`request.auth.uid`). The Admin SDK
// bypasses these rules on the server side; it is the SERVER's
// responsibility to scope every Admin SDK write/read to the
// authenticated UID (see `FirestoreUserStoreImpl`).
//
// Path layout:
//   users/{uid}                              (profile)
//   users/{uid}/preferences/_root
//   users/{uid}/memories/{memoryId}
//   users/{uid}/cognitiveState/_root
//   users/{uid}/userModel/_root
//   users/{uid}/temporal/_root
//   users/{uid}/worldState/_root
//   users/{uid}/plans/{planId}
//   users/{uid}/executions/{requestId}
//   users/{uid}/observations/{observationId}
//   users/{uid}/idempotency/{key}
//   users/{uid}/leases/{planId}
//   users/{uid}/executionSessions/{sessionId}
//   users/{uid}/executionSessionLeases/{sessionId}
//   users/{uid}/codeChangeProposals/{proposalVersionId}
//   users/{uid}/codeChangeHeads/{proposalId}
//   users/{uid}/codeChangeAudit/{eventId}
//   users/{uid}/goals/{goalId}
//   users/{uid}/learning/{patternId}
//   users/{uid}/learningExperiences/{experienceId}
//   users/{uid}/experienceReflections/{reflectionId}
//   users/{uid}/lessons/{lessonId}
//   users/{uid}/decisionObservations/{observationId}
//   users/{uid}/adaptations/{adaptationVersionId}
//   users/{uid}/adaptationHeads/{adaptationId}
//   users/{uid}/skills/{skillVersionId}
//   users/{uid}/skillHeads/{skillId}
//   users/{uid}/skillReliability/{recordId}
//   users/{uid}/toolReliability/{recordId}
//   users/{uid}/selfModel/_root
//   users/{uid}/migrations/{source}

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;

      match /preferences/_root {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.userId == uid;
      }

      match /cognitiveState/_root {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      }

      match /userModel/_root {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      }
      match /temporal/_root {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      }
      match /worldState/_root {
        allow read, delete: if isOwner(uid);
        // Assertions are mediated by the authenticated server so clients
        // cannot forge VERIFIED provenance. Admin SDK writes bypass rules.
        allow create, update: if false;
      }
      match /selfModel/_root {
        allow read: if isOwner(uid);
        // Runtime observations and calculated health are server-derived.
        // Clients cannot forge availability, reliability, or health scores.
        allow write: if false;
      }

      match /memories/{memoryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.metadata.userId == uid;
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      match /learning/{patternId} {
        allow read, write: if isOwner(uid);
      }

      // Phase 36 learning records are readable by their owner, but all writes
      // are mediated by the authenticated server so clients cannot forge
      // VERIFIED experience, approval, promotion, or reliability evidence.
      match /learningExperiences/{experienceId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /experienceReflections/{reflectionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /lessons/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /decisionObservations/{observationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /adaptations/{adaptationVersionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /adaptationHeads/{adaptationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /skills/{skillVersionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /skillHeads/{skillId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /skillReliability/{recordId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /toolReliability/{recordId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /migrations/{source} {
        allow read, write: if isOwner(uid);
      }

      match /plans/{planId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.userId == uid;
      }
      match /executions/{requestId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      }
      match /observations/{observationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      }
      match /idempotency/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      }
      match /leases/{planId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.planId == planId;
      }
      // Phase 41 session/checkpoint truth and fencing leases are server-owned.
      // The owner may inspect session progress but cannot forge completion,
      // authorization, verification, or a worker lease from a browser client.
      match /executionSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /executionSessionLeases/{sessionId} {
        allow read, write: if false;
      }
      // Phase 43 proposals and their immutable audit are created only by the
      // authenticated server. Clients cannot forge verification or approval.
      match /codeChangeProposals/{proposalVersionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /codeChangeHeads/{proposalId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /codeChangeAudit/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      // Phase 44 incidents and regression memory are derived by the server
      // from bounded diagnostics and verified applied proposals.
      match /bugIncidents/{incidentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /regressionMemories/{memoryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Health probe — public read for liveness checks; no writes.
    match /_health/ping {
      allow read: if true;
      allow write: if false;
    }
  }
}
