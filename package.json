{
  "name": "lohz",
  "private": true,
  "version": "0.1.0",
  "description": "LOHZ — local-first cognitive desktop assistant",
  "author": "LOHZ",
  "desktopName": "LOHZ",
  "main": "dist-desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "agent": "tsx windows-agent/index.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run build:desktop && electron .",
    "package:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run build:desktop && electron-builder --linux --x64 --publish never",
    "package:mac": "npm run build:desktop && electron-builder --mac --x64 --publish never",
    "release:verify": "node scripts/verify-release.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:firestore": "node scripts/run-firestore-emulator-tests.mjs",
    "test:firestore:spec": "vitest run --config vitest.emulator.config.ts",
    "test:watch": "vitest",
    "benchmark:phase36": "tsx scripts/phase36-benchmark.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.28.8",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
