# Gemini model access. Create a key in the provider console and keep the real
# value only in .env or the deployment secret manager.
GEMINI_API_KEY="replace-with-gemini-api-key"

# Public URL where this application is hosted.
APP_URL="http://localhost:3000"

# Firebase client configuration (safe to expose to the browser, but these
# values do not authenticate a user by themselves).
VITE_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="replace-with-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="replace-with-project-id"
VITE_FIREBASE_STORAGE_BUCKET="replace-with-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="replace-with-sender-id"
VITE_FIREBASE_APP_ID="replace-with-app-id"

# Absolute or repository-relative path to a Firebase Admin service-account
# JSON file. Never commit that file. Production fails closed when it is absent.
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Development/test bypass is OFF by default. Enable only for a local process
# and supply a non-production UID in the X-LOHZ-Dev-Uid header.
LOHZ_ALLOW_INSECURE_DEV_AUTH="0"

# The arbitrary HTML proxy is disabled by default. Keep it disabled unless a
# separately isolated proxy origin and an explicit destination allowlist exist.
LOHZ_ENABLE_WEB_PROXY="0"
